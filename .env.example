# SIGNL.ONE Preorder Site - Environment Variables
# Copy this file to .env.local for local development

# =====================
# STRIPE CONFIGURATION
# =====================
# Required for payment processing. Get these from https://dashboard.stripe.com/apikeys
# Without these, the site runs in demo mode (checkout shows a message instead of redirecting)

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional: Stripe webhook secret for order recording
# Get this when setting up webhooks at https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Pre-created Stripe Price ID. If not set, a price is created on-the-fly.
# STRIPE_PRICE_ID=price_...

# =====================
# BASE URL
# =====================
# Required for Stripe redirects. Set to your production domain.
# Railway auto-injects RAILWAY_PUBLIC_DOMAIN which can be used.
NEXT_PUBLIC_BASE_URL=https://your-domain.railway.app

# =====================
# DATABASE
# =====================
# SQLite database path. Defaults to ./data/orders.db
# For Railway, use a persistent volume mounted at /app/data
# DATABASE_PATH=/app/data/orders.db

# =====================
# EMAIL NOTIFICATIONS (Optional)
# =====================
# If configured, sends notification emails to sales@signl.store on new orders
# Without these, notification emails are skipped (orders still recorded)

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# MAIL_TO=sales@signl.store
